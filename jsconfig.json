{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["**/*.js", "**/*.mjs"],
  "exclude": [
    "node_modules",
    "backups",
    "logs",
    "public/downloads",
    "public/uploads",
    "android-app",
    "database",
    "auth_info_baileys"
  ]
}
