<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cetak Voucher <%= brand %> #<%= batch.id %></title>
  <style>
    @page { size: A4 portrait; margin: 3mm; }
    * { box-sizing: border-box; margin: 0; padding: 0;
        -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    body { font-family: Arial, Helvetica, sans-serif; background: #e2e8f0; padding: 10px; }

    .page {
      width: 204mm; min-height: 291mm; margin: 0 auto 10px; background: #fff;
      display: grid; grid-template-columns: repeat(8, 1fr); grid-auto-rows: 24.1mm;
    }
    .vc {
      border: 0.4mm solid #94a3b8; position: relative; overflow: hidden;
      display: flex; flex-direction: column; break-inside: avoid; page-break-inside: avoid;
    }
    .vh { background: #000; color: #fff; height: 6.4mm; display: flex; align-items: center; gap: 1mm; padding: 0 1mm; }
    .vh svg { flex: 0 0 auto; }
    .vh .brand { flex: 1; font-weight: 800; font-size: 6.4px; letter-spacing: .2px; white-space: nowrap; overflow: hidden; text-overflow: clip; }
    .vh .no { font-weight: 800; font-size: 6.4px; }
    .vbody { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0 0.6mm; }
    .vcode { font-weight: 900; font-size: 12px; letter-spacing: .2px; text-align: center; line-height: 1.05; word-break: break-all; }
    .vcode.two { font-size: 9.5px; }
    .vpass { font-size: 8px; color: #334155; margin-top: .4mm; }
    .vline { border-top: 0.5mm dashed #0f172a; margin: 0 1mm; }
    .vfoot { display: flex; justify-content: space-between; font-size: 6px; padding: .4mm 1mm .6mm; color: #0f172a; }

    .print-controls { position: fixed; bottom: 20px; right: 20px; display: flex; gap: 10px; z-index: 1000; }
    .btn-action { border: none; padding: 10px 16px; border-radius: 8px; font-weight: 700; font-size: 12px;
                  cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.2); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-back { background: #475569; color: #fff; }
    .btn-pdf { background: #0891b2; color: #fff; }
    .btn-print { background: #16a34a; color: #fff; }

    @media print {
      body { background: #fff !important; padding: 0 !important; }
      .no-print, .print-controls { display: none !important; }
      .page { margin: 0 !important; width: auto !important; min-height: auto !important; }
      .page + .page { break-before: page; page-break-before: always; }
    }
  </style>
</head>
<body>
  <%
    const PER = 96;
    const chunks = [];
    for (let i = 0; i < vouchers.length; i += PER) chunks.push(vouchers.slice(i, i + PER));
    if (chunks.length === 0) chunks.push([]);
  %>

  <% chunks.forEach((chunk, ci) => { %>
    <div class="page">
      <% chunk.forEach((v, idx) => { const no = ci * PER + idx + 1; const two = v.password && v.code !== v.password; %>
        <div class="vc">
          <div class="vh">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="#ffffff" aria-hidden="true">
              <path d="M12 20.2a1.6 1.6 0 100-3.2 1.6 1.6 0 000 3.2z"/>
              <path d="M5 10.4a10 10 0 0114 0l-1.7 1.7a7.7 7.7 0 00-10.6 0L5 10.4z"/>
              <path d="M1.7 7.1a14.6 14.6 0 0120.6 0l-1.7 1.7a12.3 12.3 0 00-17.2 0L1.7 7.1z"/>
            </svg>
            <span class="brand"><%= brand %></span>
            <span class="no">[<%= no %>]</span>
          </div>
          <div class="vbody">
            <div class="vcode <%= two ? 'two' : '' %>"><%= v.code %></div>
            <% if (two) { %><div class="vpass">P: <%= v.password %></div><% } %>
          </div>
          <div class="vline"></div>
          <div class="vfoot">
            <span>Aktif: <%= validityText %></span>
            <span><%= dateText %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% }) %>

  <div class="print-controls no-print">
    <a class="btn-action btn-back" href="/admin/vouchers">← Kembali</a>
    <a class="btn-action btn-pdf" href="/admin/vouchers/batches/<%= batch.id %>/download-pdf">⬇ Download PDF</a>
    <button class="btn-action btn-print" onclick="window.print()">🖨 Print</button>
  </div>

  <script>
    window.onload = function () {
      setTimeout(function () {
        if (!window.location.search.includes('noprint')) { window.print(); }
      }, 500);
    };
  </script>
</body>
</html>
