<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .uwrap{background:rgba(30,41,59,.55);border:1px solid var(--border);border-radius:16px}
    .uwrap .card-hd{border-bottom:1px solid var(--border)}
    .ustat{font-weight:800}
    .commits{margin:0;padding-left:0;list-style:none;display:grid;gap:8px}
    .commits li{background:rgba(15,23,42,.55);border:1px solid var(--border);border-radius:12px;padding:10px 12px;font-size:13px}
    .commits .h{font-family:ui-monospace,Consolas,monospace;color:#22d3ee;font-weight:700;margin-right:8px}
    .commits .d{color:var(--muted);font-size:11px;margin-left:6px}
    .overlay{position:fixed;inset:0;background:rgba(2,6,23,.72);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:9999}
    .overlay.on{display:flex}
    .ovbox{background:rgba(30,41,59,.95);border:1px solid var(--border);border-radius:18px;padding:26px 30px;text-align:center;max-width:380px}
    .spin{width:46px;height:46px;border:4px solid rgba(148,163,184,.25);border-top-color:#22d3ee;border-radius:50%;margin:0 auto 14px;animation:sp 1s linear infinite}
    @keyframes sp{to{transform:rotate(360deg)}}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'update', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-cloud-arrow-down"></i> <%= t('admin.update.title', 'Update') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
        <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
      </div>
    <% } %>

    <div class="card mb16 uwrap">
      <div class="card-hd"><h6 style="margin:0"><i class="bi bi-cloud-arrow-down"></i> Status Update Aplikasi</h6></div>
      <div class="card-bd">
        <% if (info && info.error) { %>
          <div class="alert alert-d"><i class="bi bi-wifi-off"></i> <%= info.error %></div>
        <% } %>

        <% if (info && info.needsUpdate) { %>
          <div class="alert" style="background:rgba(245,158,11,.15);color:#fde68a;border:1px solid rgba(245,158,11,.35);margin-bottom:14px">
            <i class="bi bi-arrow-up-circle-fill"></i> <b>Ada Update Baru Tersedia</b>
            <% if (info.commitsBehind) { %> — <%= info.commitsBehind %> perubahan baru<% } %>
          </div>
        <% } else if (info && !info.error) { %>
          <div class="alert" style="background:rgba(34,197,94,.14);color:#bbf7d0;border:1px solid rgba(34,197,94,.32);margin-bottom:14px">
            <i class="bi bi-check2-circle"></i> <b>Sudah versi terbaru</b>
          </div>
        <% } %>

        <div class="form-row" style="align-items:flex-start">
          <div class="fg">
            <label class="fl">Versi Terinstall (version.txt)</label>
            <div class="fc" style="display:flex;align-items:center;gap:8px">
              <i class="bi bi-hdd-network"></i>
              <span class="ustat"><%= info?.localVersion || '-' %></span>
            </div>
          </div>
          <div class="fg">
            <label class="fl">Versi Terbaru di GitHub (branch: <%= info?.branch || '-' %>)</label>
            <div class="fc" style="display:flex;align-items:center;gap:8px">
              <i class="bi bi-github"></i>
              <span class="ustat"><%= info?.remoteVersion || '-' %></span>
              <% if (info?.needsUpdate) { %>
                <span class="badge" style="margin-left:8px;background:rgba(245,158,11,.2);color:#fde68a"><i class="bi bi-arrow-up-circle"></i> Ada Update</span>
              <% } else if (!info?.error) { %>
                <span class="badge" style="margin-left:8px;background:rgba(34,197,94,.18);color:#bbf7d0"><i class="bi bi-check2-circle"></i> Terbaru</span>
              <% } %>
            </div>
          </div>
        </div>

        <div style="display:flex;gap:20px;flex-wrap:wrap;margin:6px 0 12px;font-size:12px;color:var(--muted)">
          <div><i class="bi bi-git"></i> Repo: <span style="color:#cbd5e1"><%= (config && config.repo) || info?.repo || '-' %></span></div>
          <div><i class="bi bi-key"></i> Akses: <span style="color:#cbd5e1"><%= (config && config.hasToken) ? 'Token aktif (repo privat)' : 'Publik / tanpa token' %></span></div>
          <div><i class="bi bi-calendar-check"></i> Update terakhir: <span style="color:#cbd5e1"><%= info?.lastUpdate || '-' %></span></div>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <form method="GET" action="/admin/update">
            <button type="submit" class="btn btn-g"><i class="bi bi-arrow-repeat"></i> Cek Update</button>
          </form>
          <form method="POST" action="/admin/update/run" id="updateForm" onsubmit="return startUpdate();">
            <button type="submit" class="btn btn-s" id="updateBtn" <%= (info && info.error) ? 'disabled' : '' %>><i class="bi bi-cloud-arrow-down"></i> Update</button>
          </form>
        </div>

        <div style="margin-top:12px;color:var(--muted);font-size:12px;line-height:1.5">
          Saat update, sistem otomatis mem-backup file penting (<b>.env</b>, <b>settings.json</b>, folder <b>database</b>, sesi WA <b>Baileys</b>, dan <b>uploads</b>), menarik versi terbaru dari GitHub, menjalankan <b>npm install</b> bila perlu, lalu me-restart layanan. File backup dipulihkan setelah selesai.
        </div>
      </div>
    </div>

    <% if (info && info.commits && info.commits.length) { %>
      <div class="card mb16 uwrap">
        <div class="card-hd"><h6 style="margin:0"><i class="bi bi-list-stars"></i> Perubahan / Commit Terbaru di GitHub</h6></div>
        <div class="card-bd">
          <ul class="commits">
            <% info.commits.forEach((c) => { %>
              <li><span class="h"><%= c.hash %></span><%= c.subject %><span class="d"><%= c.date %></span></li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>

    <% if (history && history.length) { %>
      <div class="card mb16 uwrap">
        <div class="card-hd"><h6 style="margin:0"><i class="bi bi-clock-history"></i> Riwayat Update</h6></div>
        <div class="card-bd">
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead><tr><th>Tanggal</th><th>Versi</th><th>Status</th></tr></thead>
              <tbody>
                <% history.forEach((h) => { %>
                  <tr>
                    <td><%= h.date ? new Date(h.date).toLocaleString('id-ID') : '-' %></td>
                    <td><%= h.from %> → <%= h.to %></td>
                    <td>
                      <% if (h.status === 'success') { %><span style="color:#4ade80;font-weight:700">Berhasil</span>
                      <% } else { %><span style="color:#f87171;font-weight:700">Gagal</span><% } %>
                      <% if (h.error) { %><div style="color:var(--muted);font-size:11px"><%= h.error %></div><% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>

    <% if (log) { %>
      <div class="card mb16 uwrap">
        <div class="card-hd"><h6 style="margin:0"><i class="bi bi-terminal"></i> <%= t('admin.update.log_title', 'Log Update') %></h6></div>
        <div class="card-bd">
          <pre style="white-space:pre-wrap;word-break:break-word;margin:0;background:rgba(0,0,0,0.25);padding:12px;border-radius:12px"><%= log %></pre>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div class="overlay" id="updateOverlay">
  <div class="ovbox">
    <div class="spin"></div>
    <div style="font-weight:800;font-size:16px;margin-bottom:6px">Sedang Update...</div>
    <div id="ovText" style="color:var(--muted);font-size:13px">Sedang mendownload update dari GitHub...</div>
    <div style="color:var(--muted);font-size:11px;margin-top:10px">Jangan tutup halaman ini. Proses mungkin memakan waktu beberapa saat.</div>
  </div>
</div>

<script>
  var _updating = false;
  function startUpdate() {
    if (_updating) return false; // cegah klik 2x
    var ok = confirm("Jalankan update sekarang? Pastikan koneksi internet stabil. Aplikasi akan di-restart otomatis setelah selesai.");
    if (!ok) return false;
    _updating = true;
    var btn = document.getElementById('updateBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Memproses...'; }
    var ov = document.getElementById('updateOverlay');
    if (ov) ov.classList.add('on');
    var t = document.getElementById('ovText');
    var steps = ['Sedang mendownload update dari GitHub...', 'Menarik file terbaru (git reset --hard)...', 'Menjalankan npm install bila ada paket baru...', 'Memulihkan file penting (.env, database, sesi WA)...', 'Sedang restart layanan...'];
    var i = 0;
    if (t) { setInterval(function () { i = (i + 1) % steps.length; t.textContent = steps[i]; }, 2500); }
    return true; // izinkan submit
  }
</script>
</body>
</html>
